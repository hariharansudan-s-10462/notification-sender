{
  "name": "notification-sender-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:frontend": "cd ../frontend && npm ci && npm run build && mkdir -p ../backend/public && cp -r dist/. ../backend/public/",
    "build:all": "npm run build:frontend && npm run build",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "web-push": "^3.6.7",
    "zcatalyst-sdk-node": "^3.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.1",
    "@types/web-push": "^3.6.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
